{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Comercio o tienda registrada en la plataforma",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "nit": { "type": "string", "maxLength": 30 },
        "phone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "slug": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "catalogActive": { "type": "boolean" },
        "receiptFooter": { "type": "string", "maxLength": 250 },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "SUSPENDED", "REJECTED"] },
        "businessType": { "type": "string", "maxLength": 80 },
        "planPrice": { "type": "number" },
        "maxProducts": { "type": "number" },
        "subscriptionExpiresAt": { "type": "string", "maxLength": 50 },
        "activatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "ownerId"]
    },
    "BusinessMember": {
      "title": "BusinessMember",
      "description": "Usuario asociado a un negocio con rol asignado",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["owner", "admin", "cashier"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Artículo de inventario o producto para la venta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "barcode": { "type": "string", "maxLength": 50 },
        "internalCode": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 60 },
        "brand": { "type": "string", "maxLength": 60 },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "allowDecimals": { "type": "boolean" },
        "expirationDate": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "name", "salePrice"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Registro de entrada, salida o ajuste en el inventario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["IN", "OUT", "ADJUST", "SALE", "PURCHASE", "RETURN"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "maxLength": 200 },
        "cost": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "productId", "type", "quantity"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Transacción de venta del punto de venta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "saleNumber": { "type": "number" },
        "businessId": { "type": "string", "maxLength": 128 },
        "cashierId": { "type": "string", "maxLength": 128 },
        "cashierName": { "type": "string", "maxLength": 100 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerNit": { "type": "string", "maxLength": 30 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "costTotal": { "type": "number" },
        "grossProfit": { "type": "number" },
        "status": { "type": "string", "enum": ["PAID", "PARTIAL", "CREDIT", "CANCELLED", "RETURNED"] },
        "amountPaid": { "type": "number" },
        "pendingAmount": { "type": "number" },
        "cashReceived": { "type": "number" },
        "changeGiven": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "total", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Cliente registrado para compras y cuentas fiadas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "documentType": { "type": "string", "maxLength": 20 },
        "documentNumber": { "type": "string", "maxLength": 30 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "neighborhood": { "type": "string", "maxLength": 80 },
        "creditLimit": { "type": "number" },
        "currentDebt": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "name"]
    },
    "CustomerMovement": {
      "title": "CustomerMovement",
      "description": "Movimiento de deuda o abono de cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "saleId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["DEBT", "PAYMENT"] },
        "amount": { "type": "number" },
        "previousDebt": { "type": "number" },
        "newDebt": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "customerId", "type", "amount"]
    },
    "CashShift": {
      "title": "CashShift",
      "description": "Turno o sesión diaria de caja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "cashierId": { "type": "string", "maxLength": 128 },
        "cashierName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "openedAt": { "type": "string", "maxLength": 50 },
        "closedAt": { "type": "string", "maxLength": 50 },
        "initialCash": { "type": "number" },
        "cashSales": { "type": "number" },
        "nequiSales": { "type": "number" },
        "daviplataSales": { "type": "number" },
        "transferSales": { "type": "number" },
        "cardSales": { "type": "number" },
        "creditSales": { "type": "number" },
        "cashIn": { "type": "number" },
        "cashOut": { "type": "number" },
        "expectedCash": { "type": "number" },
        "countedCash": { "type": "number" },
        "difference": { "type": "number" },
        "closingNotes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "businessId", "cashierId", "status", "initialCash"]
    },
    "CashMovement": {
      "title": "CashMovement",
      "description": "Entrada o salida de dinero en caja (gastos o ingresos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "shiftId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "category": { "type": "string", "maxLength": 60 },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "type", "amount"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Proveedor de mercancía",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "nit": { "type": "string", "maxLength": 30 },
        "contactName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "name"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Orden de compra de inventario a proveedor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "purchaseNumber": { "type": "number" },
        "businessId": { "type": "string", "maxLength": 128 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 100 },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["RECEIVED", "PENDING", "CANCELLED"] },
        "paymentStatus": { "type": "string", "enum": ["PAID", "CREDIT", "PARTIAL"] },
        "paidAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "supplierId", "total", "status"]
    },
    "CatalogOrder": {
      "title": "CatalogOrder",
      "description": "Pedido recibido por catálogo online público",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "number" },
        "businessId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerAddress": { "type": "string", "maxLength": 200 },
        "total": { "type": "number" },
        "deliveryMethod": { "type": "string", "enum": ["DOMICILIO", "RECOGER_EN_TIENDA"] },
        "paymentMethodPreference": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["NUEVO", "CONFIRMADO", "EN_CAMINO", "ENTREGADO", "CANCELADO"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessId", "customerName", "customerPhone", "total"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Información general del negocio"
    },
    "/businesses/{businessId}/members/{memberId}": {
      "schema": "BusinessMember",
      "description": "Miembros del negocio y sus roles"
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Catálogo de productos e inventario"
    },
    "/businesses/{businessId}/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Movimientos de existencias"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Ventas realizadas"
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Clientes y balance de fiados"
    },
    "/businesses/{businessId}/customerMovements/{movementId}": {
      "schema": "CustomerMovement",
      "description": "Historial de créditos y abonos de clientes"
    },
    "/businesses/{businessId}/cashShifts/{shiftId}": {
      "schema": "CashShift",
      "description": "Turnos de apertura y cierre de caja"
    },
    "/businesses/{businessId}/cashMovements/{movementId}": {
      "schema": "CashMovement",
      "description": "Entradas y salidas manuales de efectivo"
    },
    "/businesses/{businessId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Directorio de proveedores"
    },
    "/businesses/{businessId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Compras de abastecimiento"
    },
    "/businesses/{businessId}/catalogOrders/{orderId}": {
      "schema": "CatalogOrder",
      "description": "Pedidos recibidos desde el catálogo online"
    }
  }
}
